{
  config,
  lib,
  pkgs,
  ...
}:
let
  cfg = config.bornedj.nvim;

  layerPlugin =
    name:
    pkgs.vimUtils.buildVimPlugin {
      pname = "bornedj-${name}";
      version = "0";
      src = ./layers/${name};
      doCheck = false;
    };

  # Values Nix computes are handed to Lua as a module instead of being spliced
  # into Lua source, so the Lua files stay plain files on the runtimepath.
  generatedPlugin = pkgs.vimUtils.buildVimPlugin {
    pname = "bornedj-generated";
    version = "0";
    src = pkgs.writeTextDir "lua/bornedj/generated.lua" (
      "return "
      + lib.generators.toLua { } (
        {
          lua_libraries = cfg.luaLibraries;
          obsidian_workspaces = map (workspace: { inherit (workspace) name path; }) cfg.obsidian.workspaces;
        }
        // lib.optionalAttrs cfg.java.enable {
          jdtls_cmd = "${pkgs.jdt-language-server}/bin/jdtls";
        }
        // lib.optionalAttrs cfg.qml.enable {
          qmlls_cmd = "${pkgs.kdePackages.qtdeclarative}/bin/qmlls";
        }
      )
    );
    doCheck = false;
  };

  corePlugin = pkgs.vimUtils.buildVimPlugin {
    pname = "bornedj-nvim";
    version = "0";
    src = ./core;
    doCheck = false;
  };

  vim-dadbod-ui-local = pkgs.callPackage ./pkgs/vim-dadbod-ui.nix { };
in
{
  options.bornedj.nvim = {
    enable = lib.mkEnableOption "the shared neovim configuration";

    copilot.enable = lib.mkEnableOption "copilot.vim and its maps";
    java.enable = lib.mkEnableOption "jdtls, nvim-jdtls and the nvim-dap maps";
    qml.enable = lib.mkEnableOption "the qmlls language server";
    wsl.enable = lib.mkEnableOption "maps that call into the Windows host from WSL";

    luaLibraries = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [ ];
      description = "Extra directories lua_ls indexes as libraries, for example stubs generated by a package.";
    };

    obsidian.workspaces = lib.mkOption {
      type = lib.types.listOf (
        lib.types.submodule {
          options = {
            name = lib.mkOption {
              type = lib.types.str;
              description = "Workspace name shown by obsidian.nvim.";
            };
            path = lib.mkOption {
              type = lib.types.str;
              description = "Vault directory. `~` is expanded by obsidian.nvim.";
            };
          };
        }
      );
      default = [ ];
      description = "Obsidian vaults added after the shared personal and daily_notes ones. The first vault overall is the default workspace.";
    };
  };

  config = lib.mkIf cfg.enable (
    lib.mkMerge [
      {
        # mkBefore keeps personal as the default workspace when a host appends
        # its own vaults.
        bornedj.nvim.obsidian.workspaces = lib.mkBefore [
          {
            name = "personal";
            path = "~/obsidian/personal";
          }
          {
            name = "daily_notes";
            path = "~/obsidian/daily";
          }
        ];

        home.packages = with pkgs; [
          gcc
          clang-tools
        ];

        programs.neovim = {
          enable = true;
          withRuby = false;
          withPython3 = false;
          defaultEditor = true;
          viAlias = true;
          vimAlias = true;
          vimdiffAlias = true;
          withNodeJs = true;

          # After home-manager's own preamble (order 200) and before any
          # plugin/ file, so mapleader is set when the layers define maps.
          initLua = lib.mkOrder 300 (builtins.readFile ./options.lua);

          extraPackages = with pkgs; [
            typescript-language-server
            bash-language-server
            vscode-langservers-extracted
            terraform-ls
            angular-language-server
            lua-language-server
            emmet-ls
            dockerfile-language-server
            yaml-language-server
            pyright
            nixd
            tree-sitter # cli doesn't ship with the grammars anymore
            haskell-language-server
          ];

          plugins =
            with pkgs.vimPlugins;
            [
              plenary-nvim
              trouble-nvim
              vim-tmux-navigator
              markdown-preview-nvim
              nvim-cmp
              cmp-nvim-lsp
              nvim-web-devicons
              vim-dadbod
              vim-dadbod-completion
              vim-dadbod-ui-local
              claude-code-nvim
              vim-fugitive
              undotree
              # managing parsers itself, there's an open issue around doing it with nix
              nvim-treesitter.withAllGrammars
              nvim-lspconfig
              comment-nvim
              harpoon
              obsidian-nvim
              telescope-nvim
              which-key-nvim
            ]
            ++ [
              corePlugin
              generatedPlugin
            ];
        };
      }

      (lib.mkIf cfg.copilot.enable {
        programs.neovim.plugins = [
          pkgs.vimPlugins.copilot-vim
          (layerPlugin "copilot")
        ];
      })

      (lib.mkIf cfg.java.enable {
        programs.neovim = {
          plugins = [
            pkgs.vimPlugins.nvim-jdtls
            pkgs.vimPlugins.nvim-dap
            (layerPlugin "java")
          ];
          extraPackages = [ pkgs.jdt-language-server ];
        };
      })

      (lib.mkIf cfg.qml.enable {
        programs.neovim = {
          plugins = [ (layerPlugin "qml") ];
          extraPackages = [ pkgs.kdePackages.qtdeclarative ];
        };
      })

      (lib.mkIf cfg.wsl.enable {
        programs.neovim.plugins = [ (layerPlugin "wsl") ];
      })
    ]
  );
}
